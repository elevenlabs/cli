{
  "name": "Front desk",
  "conversation_config": {
    "agent": {
      "prompt": {
        "prompt": "You are the front desk.",
        "built_in_tools": {
          "end_call": null,
          "language_detection": {
            "name": "language_detection",
            "type": "system",
            "params": {
              "system_tool_type": "language_detection",
              "only_at_conversation_start": true
            }
          },
          "transfer_to_agent": {
            "description": "Hand the caller to a specialist agent",
            "name": "transfer_to_agent",
            "params": {
              "system_tool_type": "transfer_to_agent",
              "transfers": [
                {
                  "agent_id": "agent_sales",
                  "condition": "Caller wants to buy something",
                  "delay_ms": 500,
                  "transfer_message": "Connecting you to sales"
                },
                {
                  "agent_id": "agent_billing",
                  "condition": "Caller has a billing problem",
                  "node_id": "refunds"
                }
              ]
            },
            "type": "system"
          },
          "transfer_to_number": {
            "name": "transfer_to_number",
            "params": {
              "enable_client_message": false,
              "system_tool_type": "transfer_to_number",
              "transfers": [
                {
                  "condition": "Caller asks for billing",
                  "transfer_destination": {
                    "phone_number": "+15551234567",
                    "type": "phone"
                  }
                },
                {
                  "condition": "Caller asks for their account manager",
                  "transfer_destination": {
                    "phone_number": "manager_phone",
                    "type": "phone_dynamic_variable"
                  },
                  "transfer_type": "conference"
                },
                {
                  "condition": "Caller is a reseller partner",
                  "sip_refer_play_dialtone": true,
                  "transfer_destination": {
                    "sip_uri": "sip:partners@pbx.example.com",
                    "type": "sip_uri"
                  },
                  "transfer_type": "sip_refer"
                }
              ]
            },
            "type": "system"
          }
        }
      }
    }
  }
}
